<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ReplayTool</AssemblyName>
    <RootNamespace>ReplayTool.App</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>12</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReplayTool.Core\ReplayTool.Core.csproj" />
  </ItemGroup>

  <!-- 若需要随应用捆绑 FFmpeg，将 ffmpeg.exe / ffprobe.exe 放入 libs\ffmpeg 并启用以下条目
  <ItemGroup>
    <None Include="..\..\libs\ffmpeg\ffmpeg.exe" Link="ffmpeg\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\libs\ffmpeg\ffprobe.exe" Link="ffmpeg\ffprobe.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  -->

</Project>
