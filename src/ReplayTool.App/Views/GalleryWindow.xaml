<Window x:Class="ReplayTool.App.Views.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="我的捕获 - 图库"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Microsoft YaHei UI">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button Content="刷新" Width="70" DockPanel.Dock="Right" Style="{StaticResource ButtonStyle}" Click="Refresh_Click"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Style="{StaticResource HintStyle}"/>
        </DockPanel>

        <ListView x:Name="ItemList" Grid.Row="1"
                  Background="{StaticResource PanelBg}"
                  BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1"
                  SelectionMode="Extended"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开" Click="Open_Click"/>
                    <MenuItem Header="打开所在文件夹" Click="OpenLocation_Click"/>
                    <MenuItem Header="复制文件路径" Click="CopyPath_Click"/>
                    <Separator/>
                    <MenuItem Header="删除" Click="Delete_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="2"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="文件" Width="360" CellTemplate="{StaticResource FileNameTemplate}"/>
                    <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding TypeText}"/>
                    <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="修改时间" Width="140" DisplayMemberBinding="{Binding ModifiedText}"/>
                    <GridViewColumn Header="路径" Width="260" DisplayMemberBinding="{Binding FullPath}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
